# Copy this file to `.env` in the project root, fill in values, then restart `npm run dev`.
# Get Firebase keys: Firebase Console → Project settings → Your apps → Web app config.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Local COLMAP (optional — multi-view reconstruction)
RECON_COLMAP_EXECUTABLE=
RECON_POISSON_DEPTH=10
RECON_POISSON_SUBDIVIDE=2
